    "metaData" : {
      "description" : "Represents a payment transaction with support for multiple payment methods"
    },
    "schemaDefinition" : {
      "$anchor" : "sample_id_1",
      "$schema" : "https:\/\/json-schema.org\/draft\/2020-12\/schema",
      "properties" : {
        "amount" : {
          "description" : "The total amount charged for this transaction",
          "minimum" : 0,
          "type" : "number"
        },
        "legacyType" : {
          "deprecated" : true,
          "description" : "Legacy transaction type field",
          "type" : "string"
        },
        "mapData" : {
          "additionalProperties" : {
            "properties" : {
              "data" : {
                "type" : "string"
              },
              "propertyData" : {
                "properties" : {
                  "data" : {
                    "type" : "string"
                  }
                },
                "required" : [
                  "data"
                ],
                "type" : "object"
              }
            },
            "required" : [
              "data",
              "propertyData"
            ],
            "type" : "object"
          },
          "propertyNames" : {
            "pattern" : "^(true|false)$"
          },
          "type" : "object"
        },
        "paymentMethod" : {
          "oneOf" : [
            {
              "properties" : {
                "bic" : {
                  "description" : "Bank Identifier Code",
                  "type" : "string"
                },
                "iban" : {
                  "description" : "International Bank Account Number",
                  "pattern" : "^[A-Z]{2}[0-9]{2}[A-Z0-9]{1,30}$",
                  "type" : "string"
                },
                "payment_method" : {
                  "const" : "bank_transfer"
                },
                "type" : {
                  "type" : "string"
                }
              },
              "required" : [
                "payment_method",
                "type",
                "iban",
                "bic"
              ],
              "title" : "BankTransfer",
              "type" : "object"
            },
            {
              "properties" : {
                "accountNumber" : {
                  "type" : "string"
                },
                "bankLogoURL" : {
                  "type" : "string"
                },
                "bankName" : {
                  "type" : "string"
                },
                "id" : {
                  "format" : "uuid",
                  "type" : "string"
                },
                "maskedAccountNumber" : {
                  "type" : "string"
                },
                "payment_method" : {
                  "const" : "credit_card"
                },
                "spendPercentage" : {
                  "type" : "integer"
                }
              },
              "required" : [
                "payment_method",
                "id",
                "accountNumber",
                "bankName",
                "spendPercentage",
                "maskedAccountNumber"
              ],
              "title" : "CreditCard",
              "type" : "object"
            },
            {
              "properties" : {
                "email" : {
                  "description" : "PayPal account email address",
                  "pattern" : "^[^@]+@[^@]+\\\\.[^@]+$",
                  "type" : "string"
                },
                "payment_method" : {
                  "const" : "paypal"
                },
                "type" : {
                  "type" : "string"
                }
              },
              "required" : [
                "payment_method",
                "type",
                "email"
              ],
              "title" : "PayPal",
              "type" : "object"
            }
          ],
          "type" : "object"
        },
        "transactionId" : {
          "type" : "string"
        }
      },
      "required" : [
        "transactionId",
        "amount",
        "paymentMethod",
        "mapData"
      ],
      "type" : "object"
    },
    "status" : "APPROVED"
  },
