      "description" : "Schema for selecting a delivery method at checkout"
    },
    "schemaDefinition" : {
      "$anchor" : "delivery_method_schema",
      "$schema" : "https:\/\/json-schema.org\/draft\/2020-12\/schema",
      "properties" : {
        "model" : {
          "oneOf" : [
            {
              "properties" : {
                "estimatedDays" : {
                  "description" : "Estimated number of business days for delivery",
                  "maximum" : 14,
                  "minimum" : 1,
                  "type" : "integer"
                },
                "type" : {
                  "const" : "standard"
                }
              },
              "required" : [
                "type",
                "estimatedDays"
              ],
              "title" : "StandardDelivery",
              "type" : "object"
            },
            {
              "properties" : {
                "estimatedDays" : {
                  "description" : "Estimated number of business days for express delivery",
                  "maximum" : 3,
                  "minimum" : 1,
                  "type" : "integer"
                },
                "priority" : {
                  "description" : "Priority level for express shipment",
                  "pattern" : "^(high|medium|low)$",
                  "type" : "string"
                },
                "type" : {
                  "const" : "express"
                }
              },
              "required" : [
                "type",
                "estimatedDays",
                "priority"
              ],
              "title" : "ExpressDelivery",
              "type" : "object"
            }
          ],
          "type" : "object"
        }
      },
      "required" : [
        "model"
      ],
      "type" : "object"
    },
    "status" : "APPROVED"
  },
